{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/discover",
      "destination": "/discover.html"
    },
    {
      "source": "/how-it-works",
      "destination": "/how-it-works.html"
    },
    {
      "source": "/events-in-kenya",
      "destination": "/events-in-kenya.html"
    },
    {
      "source": "/events/:slug",
      "destination": "/events/:slug.html"
    },
    {
      "source": "/events-in/:county",
      "destination": "/events-in/:county.html"
    },
    {
      "source": "/events/category/:category",
      "destination": "/events/category/:category.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
